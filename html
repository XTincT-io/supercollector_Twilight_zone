      </span>
    </div>
  </div>

  <!-- ============================================================
       MAIN RELEASE GRID
       ============================================================ -->
  <div class="release-wrapper">

    <!-- LEFT: artwork + info -->
    <div class="release-header">
      <div class="artwork-outer">
        <div class="artwork-frame">
          <!-- Replace this placeholder with your actual artwork img tag:
               <img src="YOUR_ARTWORK_URL" alt="Twilight Zone EP artwork">
          -->
          <div class="artwork-placeholder">
            <!-- artwork goes here -->
          </div>
          <div class="artwork-glitch" aria-hidden="true"></div>
          <div class="tz-badge">TZ-EP-2026</div>
        </div>
