      <div class="release-info">
        <a href="https://audius.co/xtinct_official" class="artist-name" style="text-decoration:none">XTincT</a>
        <div class="release-title">TWILIGHT ZONE</div>
        <span class="release-year">2026</span>

        <button
          class="play-btn"
          aria-label="Play Twilight Zone EP"
          onclick="this.classList.toggle('is-active')"
        >
          <div class="play-tri" aria-hidden="true"></div>
        </button>

        <span class="track-count">3 TRACKS</span>
      </div>

